Wa"}],"key":"upQV0bCgI3"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://github.com/Cross-Domain-Interoperability-Framework/validation/tree/main/converters/ROCrate","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Transform RO-CRATE to/from CDIF","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"mye1lZ6uXK"}],"urlSource":"https://github.com/Cross-Domain-Interoperability-Framework/validation/tree/main/converters/ROCrate","error":true,"key":"g8ZbfxfLho"}],"key":"E2i9tkfH98"}],"key":"BEAb70Tie6"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://github.com/Cross-Domain-Interoperability-Framework/profile-manifest/tree/v1.1.1/examples","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Example instance files","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"TplA1fAwWc"}],"urlSource":"https://github.com/Cross-Domain-Interoperability-Framework/profile-manifest/tree/v1.1.1/examples","error":true,"key":"lkLukNuGPl"}],"key":"qahZksEnSx"}],"key":"MjCKgX0Nd7"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/cdif-uml-model/CDIFManifest/index.html","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Graphical view","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"OfqKevZmfF"}],"urlSource":"https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/cdif-uml-model/CDIFManifest/index.html","key":"YX2I0tZruR"}],"key":"c1AoUelgnA"}],"key":"AqdzHYXbvM"}],"key":"xAtDfNRdwP"},{"type":"heading","depth":3,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Overview","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"uhYKvYHIhO"}],"identifier":"overview","label":"Overview","html_id":"overview","implicit":true,"key":"r7K9CFR4AE"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Within the set of FAIR functions supported by the CDIF guidelines is a practical need to construct packages of related files that are treated as a single resource. This requirement appears in different forms: Researchers must be able to collect and group the various resources involved in their research, so that sense can be made of it for the purposes of replication, comprehension, and reuse. Archives and repositories have a requirement for packages of related resources to be submitted and stored, and these form the basis for dissemination. There is the popular concept of a FAIR Digital Object (FDO) which can be anything FAIR – even an atomic metadata item – but in practical terms requires that coherent packages be assembled to support practical use.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"lwECUu6LPU"}],"key":"wFqlCuZeZv"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"In a networked scenario, it may not always be the case that every required resource is stored at the same location or is found within the same repository (even a distributed one). In such a case, the idea of a “package” is not so much a physical assembly as it is a list of needed resources and the addresses – local or otherwise – which can be used to retrieve them. Different scenarios of use will impose different restrictions on how such packages need to be stored, but in their most basic form, they are a list of resources and locations: a manifest.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"dqCXXg6agZ"}],"key":"SsLM5uSWuB"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"This CDIF recommendation is designed to support documentation of resource packages, the core items which make up a manifest. This document outlines the basic requirement, the conceptual model, and discusses specific implementation using ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"nOy8Ghgx9z"},{"type":"link","url":"http://schema.org","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"schema.org","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"CHF03XomRi"}],"urlSource":"http://schema.org","key":"kBzNl0rBvv"},{"type":"text","value":" and RO-Crate.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"QIrY7ic5Cm"}],"key":"yUAMtLfs4m"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Requirements","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"t8l5PberO4"}],"identifier":"requirements","label":"Requirements","html_id":"requirements","implicit":true,"key":"Xn8sCxNi9M"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":20,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Support the retrieval of complete packages of related resources sufficient for the FAIR use of a data or metadata object","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Y5E9bv5xGM"}],"key":"RtCTjWttdF"}],"key":"hKFlob0Xfq"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Contain a listing of each component part, along with needed identifiers, descriptors, typing, and charaterization so that both humans and machines can understand its content and relationship to other parts of the package","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"ON6FYjR7e1"}],"key":"BIWwIC1Gif"}],"key":"ELA8B3mnhL"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Provide information sufficient to retrieve each of its component parts within the context of the system or network on which it is located. This does not require that the individual parts of the package can be retrieved on the web.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"X6mczQZ1Br"}],"key":"mx3YTdJDzP"}],"key":"DvJu46Phbb"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Be self-describing so that a receiving system can determine how to process it. Ideally, it will be useable by any application which supports the type of packaging which was used to implement the CDIF model (that is, it will not require a CDIF-aware application to unpack).","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"uQMNgehVA2"}],"key":"PuUKR2wiOp"}],"key":"Xtp0k3qvEG"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify conformance to the CDIF Manifest profile, so that receiving systems can understand how to operate on it if they support the CDIF profile.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"qLXhnEFdcJ"}],"key":"q8kYjRPriv"}],"key":"Y79hkNKiQu"}],"key":"PbWwmIWiXM"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Note that functioning as an FDO is not necessarily a requirement out of the starting gate - that should be added later, once we can figure out what it means. It is not a business requirement.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"FxC0YdmpR1"}],"key":"Zcf5L2wPIC"},{"type":"heading","depth":3,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Information Model","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"ybwGfDcaIr"}],"identifier":"information-model","label":"Information Model","html_id":"information-model","implicit":true,"key":"oOUomj1XhV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Protocol Conformance Statement (Required) – a statement of the protocol used to constitute the package being described, and to which supplied information conforms (RO Crate, Frictionless Data, etc.)","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"cgQpOVU0aC"}],"key":"S6k3abZ56u"}],"key":"ELA4fIvGbJ"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Package identification  (R) – a unique identifier for the package, according to a known scheme","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"Nj2GjUk3Ot"}],"key":"q2a30Q6bdB"}],"key":"li1WTBSG3U"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Package name (O) – a human-readable name for the package to help distinguish it from others.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"rbuj7DenEV"}],"key":"tQvaCBoym1"}],"key":"roQhJB9wmY"},{"type":"listItem","spread":true,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Package description (O) – a human-readable description of the package and its contents and purpose.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"Fgrq6oTIhC"}],"key":"qY8sDQRd2D"}],"key":"Oph1dmlLsN"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Package date (O) – The data of the creation of the package (may include time).","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"OyhgmMMNTK"}],"key":"rJkTvDaqEt"}],"key":"wLI0yobMUj"},{"type":"listItem","spread":true,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Package creator (O) – Information about the creator of the package for the purposes of attribution. May contain contact information.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"SUtFqXSR8X"}],"key":"PAmXQTTGhJ"}],"key":"bypBk0Z6Q8"},{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Distribution Information (conditional) – information needed to locate and retrieve the package (unless the metadata is an item inside the package).","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"tVgezPwWhX"}],"key":"HrwEvzrIkn"}],"key":"Wt9HuYrfzC"},{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Item List (R) – A list of the items which are the parts of the package. Each has an ID and a location. These may be local (within the package container) or somewhere on a network, with the provided location information being sufficient for them to be retrieved.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"gTmSwc6aJP"}],"key":"Sh32IzKTXw"}],"key":"uwyWPuereR"},{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Item type (R) - categorization of kinds of item, typically MIME type, other categories or  semantic classification also allowed (e.g., “data entities,” “context entities”).","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"EzhPVETJHX"}],"key":"fF38BQhZ1h"}],"key":"CxrtccW5i8"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Licensing information (R) – according to IP law, assemblages can have different licensing than their constituent parts. The license for the package is required, but more restrictive licenses may be associated with individual resources in the package.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"qC77hd9b5K"}],"key":"UqQZNTYkQm"}],"key":"yGsvzhNCDs"}],"key":"jJ1nPXCTlF"},{"type":"heading","depth":3,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Implementation","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"PZvORjZKnI"}],"identifier":"implementation","label":"Implementation","html_id":"implementation","implicit":true,"key":"zhFHv5n5K3"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"This model can be implemented in different ways – it could be an RO Crate, a Frictionless Data Data Package, a ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"WYBzvgmaAp"},{"type":"link","url":"http://schema.org","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"schema.org","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"WjoYqvoQRG"}],"urlSource":"http://schema.org","key":"YiFg257tTv"},{"type":"text","value":" DataDownload with parts, etc.  There are two main use scenarios:1) a standalone metadata record describes a packaged resource for use by metadata harvesters indexing metadata records for discovery interfaces; 2) The metadata record is included inside a data package for use by applications using the contents of the package. RO-CRATE is focused on the second case, whereas most of the CDIF effort has been in support of the first case. The CDIF data description and data structure profiles provide metadata elements to document the structure of data in individual media object in a package.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ZJ1t3U1n6V"}],"key":"suVCg6GcFW"},{"type":"heading","depth":4,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"RO Crate","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"K1CrwOiLua"}],"identifier":"ro-crate","label":"RO Crate","html_id":"ro-crate","implicit":true,"key":"rJ65MDHMXh"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{