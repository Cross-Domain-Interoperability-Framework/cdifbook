ildren":[{"type":"text","value":"Administrative areas (many ranks and functions)","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"e1sV8pQEiG"}],"key":"bdP1itkcln"}],"key":"dKo8O94Onz"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Post-codes","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"AMMlJvrEuU"}],"key":"BKoE1trpBj"}],"key":"mXWTsxYag6"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Electoral districts","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"D2oJMdOcui"}],"key":"NRa8ehj8BT"}],"key":"VPoMyq0d0d"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Statistical areas","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"TtfwuJfkX0"}],"key":"Vck3BKWGTJ"}],"key":"A8zkrSTGQ2"}],"key":"RoZLVwx7Rc"}],"key":"GMJddR9IId"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Grids, DGGS","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"niZD3sethU"}],"key":"zViJZtMEBV"}],"key":"N12I9fRsY3"}],"key":"oTCTV8QS2h"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Different applications use different systems, reflecting information requirements which often cannot be controlled by those managing or disseminating data (e.g., in the natural sciences you may find coordinates or grid-cells, where dissemination and implementation science might use coordinates or point-of-interest, social scientists and official statisticians would use named areas, statistical areas, or administrative areas, and utilities might use addresses or post-codes).","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"pcsEVyrjEA"}],"key":"GJuMY9d0uI"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"It is often best to describe locations using the systems employed by the creator of the data, leaving it up to the data integrator to perform needed translations, because the approach to harmonising locations can be driven by the methods employed for analysis and depend on the research question in a particular case. What we can do, however, is to make sure that needed information is present to unambiguously understand the locations as described. The following sections look at some of the common location systems in use.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"TVHtFTRyun"}],"key":"eC0Baeabsv"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Coordinate-based location","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"wavN290PQm"}],"identifier":"coordinate-based-location","label":"Coordinate-based location","html_id":"coordinate-based-location","implicit":true,"key":"ExAcirInlh"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Coordinate values","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"sgeywJa286"}],"identifier":"coordinate-values","label":"Coordinate values","html_id":"coordinate-values","implicit":true,"key":"aWwDG1PQc0"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"For points, lines, and polygons (including bounding-boxes) coordinate-based locations are used, usually longitude and latitude, in decimal-degrees.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"e2l8Ddy4dz"}],"key":"RCjrGnAZTV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It is important to pay attention to the coordinate sign: longitudes in the western hemisphere (west of the Greenwich meridian) are negative, and latitudes south of the equator are negative.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"qv1dBVWcCa"}],"key":"DsOBnOi4vh"}],"key":"AU9qMGcDLr"},{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Coordinate order is also important: in traditional cartographic and navigation systems the order was (latitude,longitude), i.e. (y,x); however most modern digital systems follow the more common (x,y) order from maths and graphics i.e. (longitude, latitude).","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"yfhSg6xT6l"}],"key":"z55XooxZgx"}],"key":"w1NTI0Tpqa"}],"key":"ChqfPFQWzk"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"With unfamiliar data, it is always worth checking both sign and coordinate order before doing any other data manipulations.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"P0rBDzcEAO"}],"key":"TjLySYLKpM"},{"type":"heading","depth":4,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Coordinate reference system","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"oAq5GjOiqF"}],"identifier":"coordinate-reference-system","label":"Coordinate reference system","html_id":"coordinate-reference-system","implicit":true,"key":"e3ewkB48xN"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"It is essential to supply a coordinate reference system (usually by reference) with any set of coordinates; without this, they are easily misinterpretated and the errors can be in kiometres on the ground.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"XTxw1riozw"}],"key":"RxsKMpPrSD"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The most commonly used coordinate reference system (CRS) for geographic coordinates is ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"FGMSYH94SB"},{"type":"link","url":"https://earth-info.nga.mil/index.php?dir=wgs84&action=wgs84","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"WGS 84","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"ZhSUtsWBWf"}],"urlSource":"https://earth-info.nga.mil/index.php?dir=wgs84&action=wgs84","key":"mPDis6raZZ"},{"type":"text","value":". This is the default system used by GPS receivers, and most Web-mapping applications, so if the CRS is not explicit it can generally be assumed to be WGS 84. This is also the default for the common geometry representations, such as ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"nMPS6kRlMB"},{"type":"link","url":"https://en.wikipedia.org/wiki/GeoJSON","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"GeoJSON","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"FLNfnwsaAv"}],"urlSource":"https://en.wikipedia.org/wiki/GeoJSON","data":{"page":"GeoJSON","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"O94Dw0i2hk"},{"type":"text","value":" and the ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"umzhy9sTwx"},{"type":"link","url":"https://en.wikipedia.org/wiki/Well-known_text_representation_of_geometry","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Well Known Text Representation of Geometry (WKT)","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"gUj3GZve1o"}],"urlSource":"https://en.wikipedia.org/wiki/Well-known_text_representation_of_geometry","data":{"page":"Well-known_text_representation_of_geometry","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"UFtpjIJdH3"},{"type":"text","value":". However, it should be noted that WGS 84 as a satellite based system is ignorant of change in the surface of the earth (e.g. tectonic drift) so if the data relates to phenomena on or near the surface of the earth, either provide a time stamp with the coordinates or use a terrestrial reference frame, e.g. ETRS-89 (EPSG::4258) for the European tectonic plate.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"Dfzdq0AZjR"}],"key":"UtSAL2cQT1"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"The definition of a CRS involves several pieces of information, including the axis directions and measurement units, the origin location where the value is (0,0), as well as the ellipsoid that is used to approximate the shape of the earth. Some CRS are three-dimensional, including elevation. The de facto authority for definitions of coordinate reference systems is ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"ZS4oof36VN"},{"type":"link","url":"https://epsg.org","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"EPSG","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"IuDDcEpQJk"}],"urlSource":"https://epsg.org","key":"W4VAelPDhj"},{"type":"text","value":". Properly speaking, EPSG now refers to a set of products maintained by the International Association of Oil and Gas Producers (IOGP)'s Geoinformatics Committee. These products originated with the European Petroleum Survey Group (EPSG), which merged with the IOGP in 2005. They maintain a registry with a Web API at ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"EXBzWQZXMM"},{"type":"link","url":"https://apps.epsg.org/api/swagger/ui/index","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"https://​apps​.epsg​.org​/api​/swagger​/ui​/index","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"RdDtDGVtEZ"}],"urlSource":"https://apps.epsg.org/api/swagger/ui/index","key":"n6No0eyMRo"},{"type":"text","value":". The EPSG is used by many mapping software systems, and other Web copies are available (e.g. ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"aBcTgdstpX"},{"type":"link","url":"https://epsg.io","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"https://epsg.io","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"SgrhJGNd9v"}],"urlSource":"https://epsg.io","key":"Jm0sUMaSTE"},{"type":"text","value":"). WGS 84 is denoted EPSG:4326 and the full definition can be found at ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"FafHaxVuwx"},{"type":"link","url":"https://apps.epsg.org/api/v1/CoordRefSystem/4326/export/?format=wkt","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"https://​apps​.epsg​.org​/api​/v1​/CoordRefSystem​/4326​/export​/​?format​=​wkt","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"KGeAl0FfIh"}],"urlSource":"https://apps.epsg.org/api/v1/CoordRefSystem/4326/export/?format=wkt","key":"YdXqVCX92a"},{"type":"text","value":".","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"JKSZ9r8sDt"}],"key":"XSeV4mQDTl"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Some jurisdictions have legal requirements to use other coordinate reference systems for some applications for official purposes. For example, the British National Grid is standard in the UK, in which the coordinates are given in metres, and the origin is fixed so that all locations within the UK have positive coordinate values. The British National Grid is denoted EPSG:27700 and the full definition is found at ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"vrEKmutySH"},{"type":"link","url":"https://epsg.org/crs_27700/OSGB36-British-National-Grid.html","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"https://​epsg​.org​/crs​_27700​/OSGB36​-British​-National​-Grid​.html","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"upfXzehZRT"}],"urlSource":"https://epsg.org/crs_27700/OSGB36-British-National-Grid.html","key":"anJe4J05gc"},{"type":"text","value":" or ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"wELpthoPg4"},{"type":"link","url":"https://epsg.io/27700","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"https://​epsg​.io​/27700","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"VgPx2HVvyW"}],"urlSource":"https://epsg.io/27700","key":"apcFbN3vA0"},{"type":"text","value":".","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"eruOoTXqZJ"}],"key":"IGXixNOO34"},{"type":"heading","depth":2,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Shapes","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"yt30jHeklf"}],"identifier":"shapes","label":"Shapes","html_id":"shapes","implicit":true,"key":"nC1LCZoY3z"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Point-location is defined by a single set of coordinates. Areas are usually represented by their perimeter polygon. This is defined by an ordered sequence of points, where the last point should coincide with the first in order to close the polygon. The minimum and maximum values for an extensive location define a bounding-box. The orientation of the boundaries of a bounding box align to the CRS used to describe the corners of the box. For example, for coordinates specified using latitude and longitude, the bounding box is delimited by meridians and parallels.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"bnmFDoMe88"}],"key":"EaeazXaQ6l"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"GeoJSON and WKT provide specific encodings. DCAT provides the following predicates that relate spatial information to a dataset:","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"TUMy8ZRBkR"}],"key":"ZMA6sSqew3"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":54,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"dcterms:spatial for the spatial extent of the data;","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"GXIgzwfsrp"}],"key":"eQLA1zY2G2"}],"key":"gnCxTnWWlS"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"dcat:spatialResolutionInMeters for the spatial precision or spacing of items within a\ndataset.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"tB8AkCGSzQ"}],"key":"msiOHk9CpW"}],"key":"Cm5SbUJzkR"}],"key":"hdzfuUQQyv"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"The Global Biodiversity Information Facility (GBIF) has a geo-referencing ","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"q4b5nSxDsh"},{"type":"cite","url":"https://doi.org/10.15468/doc-gg7h-s853","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"best practice guide","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"sdM3yZmlRN"}],"kind":"narrative","label":"https://doi.org/10.15468/doc-gg7h-s853","identifier":"https://doi.org/10.15468/doc-gg7h-s853","enumerator":"1","key":"Dk5So2r4wx"},{"type":"text","value":" that covers latitude, longitude, altitude, and depth. This is a good resource for determining good practice.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"nQgtsjt6eO"}],"key":"QU5mf3L1jY"},{"type":"heading","depth":2,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Identifier-based location","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"y4nbCEGRVp"}],"identifier":"identifier-based-location","label":"Identifier-based location","html_id":"identifier-based-location","implicit":true,"key":"l9mx84wJem"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Nominal systems associate a name or code to some spatial location or region. Commonly used cases include:","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"wPGV7GUEOV"}],"key":"rUJAEnAmvS"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":62,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Countries;","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"AwNbOWLKmf"}],"key":"peotesaWSn"}],"key":"yeG1TQYmZx"},{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Administrative units (e.g. ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"xHCCxIn2fj"},{"type":"link","url":"https://en.wikipedia.org/wiki/Nomenclature_of_Territorial_Units_for_Statistics","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"NUTS - Nomenclature of Territorial Units for Statistics","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"tRkQIhkrU1"}],"urlSource":"https://en.wikipedia.org/wiki/Nomenclature_of_Territorial_Units_for_Statistics","data":{"page":"Nomenclature_of_Territorial_Units_for_Statistics","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"ZDSbrzisdq"},{"type":"text","value":"): states, provinces, cities, local government areas);","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"vQ2w1Mvc85"}],"key":"xVNZojMmd2"}],"key":"Xjb7pZTsqK"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Statistical areas (defined by statistical agencies or census bureaus, e.g., the ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"gkfYDtq3Xs"},{"type":"link","url":"https://www.abs.gov.au/statistics/standards/australian-statistical-geography-standard-asgs-edition-3/jul2021-jun2026#asgs-diagram","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Australian Statistical Geography","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"uHEcwQgkRP"}],"urlSource":"https://www.abs.gov.au/statistics/standards/australian-statistical-geography-standard-asgs-edition-3/jul2021-jun2026#asgs-diagram","key":"nCaV1QqZsi"},{"type":"text","value":");","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"P4FjSccKdk"}],"key":"jWX5irl3wk"}],"key":"IXyewK7n7J"},{"type":"listItem","spread":true,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Electoral districts (whose geographic footprint may change frequently so date is required);","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"XjkHZRnlYV"}],"key":"rrEJvJaVL3"}],"key":"duU4kJdRJz"},{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Postcodes.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"x9rEqzWzGc"}],"key":"JvVOHNDNiB"}],"key":"TOBucqIlqn"}],"key":"PwHJphBpKW"},{"type":"heading","depth":3,"position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Reference system","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"pyf7JX1czf"}],"identifier":"reference-system","label":"Reference system","html_id":"reference-system","implicit":true,"key":"Dw4nQMt91F"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"In most - but not all - cases, there is a well-defined mapping of the name or code to a geospatial area. For names the list of mappings is called a gazetteer. The authority for this mapping may be well known, or may be more informal.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"EVAujSj4To"}],"key":"YyT1Raz3i1"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Statutory naming authorities typically have a formal process for gazetting (publishing) geographic names.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"sfTLTACQFz"}],"key":"NuM6AwncYR"}],"key":"ageZyZZSuu"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Postcodes are usually well-known and often convenient, however the exact mapping to space may be proprietary to a local postal delivery service.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"BeQ2xUcWO6"}],"key":"dmDg9TzKzX"}],"key":"OANFEhoqc3"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://www.geonames.org/v3/","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"GeoNames","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"AnDvjUwlWJ"}],"urlSource":"https://www.geonames.org/v3/","key":"EjW8OrhojR"},{"type":"text","value":" is a crowd-sourced service that associates a point-location with many geographic names. The location used for arealy-extensive places can be inconsistent.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"w0SCeZ5IVf"}],"key":"BfEnCYJtFJ"}],"key":"aJE3e1Uqdm"}],"key":"mbIFyuPGdC"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"In many or most cases the mapping of a name to a geospatial area is time dependent. In some cases the area attached to a name is contested, for political and cultural reasons, or because of historical uncertainty. Contemporary name-based systems are generally managed nationally or locally. Historical systems are generally more difficult and there may not be an authoritative source. Geonames is a pretty good general-purpose service, but it only gives a point-location falling somewhere within the place.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"s4ejue2Mut"}],"key":"bIASVtmLoD"},{"type":"heading","depth":2,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Grids","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"UHIRyxsqRW"}],"identifier":"grids","label":"Grids","html_id":"grids","implicit":true,"key":"OuHLDozFHI"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Where a dataset is composed of variables or properties whose value varies across a spatial domain, it is often represented as sampled discretely at locations on a regular grid. Discrete Global Grids (DGG) are an emerging alternative to cartesian grids.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"IwNFuSQI9P"}],"key":"BUHqIk2h0L"},{"type":"heading","depth":3,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Reference system","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"bSmeIveWOP"}],"identifier":"reference-system","label":"Reference system","html_id":"reference-system-1","implicit":true,"key":"zOBmsOWMQx"},{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"The most common grid arrangement is specified in terms of an origin and axis directions (with respect to a CRS), and cell spacing. A location within the grid is then indicated by an integer index or count e.g. (234, 8916). Spatial grids may be one-, two-, three-, or four-, (spatio-temporal) dimensional.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"kj1lvoeinb"}],"key":"HF9tGeQ9yO"},{"type":"heading","depth":3,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Usage","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"CqGpXrXI9x"}],"identifier":"usage","label":"Usage","html_id":"usage","implicit":true,"key":"icqK8CQrzR"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Spatial variation of a property across a spatial domain is commonly represented and exchanged using grids. Visualisations almost always use a cartesian (rectangular) gridded representation. Grids are the most common representation for spatial analysis and numerical modelling. Grids are convenient for data integration. However, they may need to be re-sampled or interpolated to a common orientation and spacing. Different DGGs are efficient for topology and proximity analysis, and area-based calculations.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"D1fBYhaOYf"}],"key":"tH49Pw6HwX"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Addresses","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"jzw8AkJKL6"}],"identifier":"addresses","label":"Addresses","html_id":"addresses","implicit":true,"key":"k7MbgqwP2F"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Many different sources exist for the description of addresses. Among these are EPSG, ISO ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"yYfMihPFF0"},{"type":"link","url":"https://www.iso.org/standard/59164.html","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"19101-1:2014","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"HxVkL76vN2"}],"urlSource":"https://www.iso.org/standard/59164.html","key":"A1pBlPC00s"},{"type":"text","value":" and ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"xDtMelSf5A"},{"type":"link","url":"https://www.iso.org/obp/ui/#iso:std:iso:19107:ed-1:v1:en","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"ISO 19107:2003","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"AjzswTTOwQ"}],"urlSource":"https://www.iso.org/obp/ui/#iso:std:iso:19107:ed-1:v1:en","key":"brqgjv8MDU"},{"type":"text","value":".","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"eo7eqARUY0"}],"key":"cBEwWru9Yr"},{"type":"comment","value":" cdif-footer-include ","key":"L6GszvQCIb"},{"type":"include","file":"../_static/footer.md","literal":false,"lang":"markdown","children":[{"type":"thematicBreak","key":"T0MxY8Kqcd"},{"type":"div","style":{"fontSize":"0.85em","opacity":"0.85","marginTop":"1em"},"children":[{"type":"paragra