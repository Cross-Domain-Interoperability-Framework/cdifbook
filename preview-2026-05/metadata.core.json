e":13,"column":1}},"key":"Ed0Oi6w3Qm"},{"type":"link","url":"http://schema.org","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"schema.org","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"vGVA82CUeK"}],"urlSource":"http://schema.org","key":"KlNhw1ERyu"},{"type":"text","value":" conventions from ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"l8pyEV3W3Z"},{"type":"link","url":"https://github.com/ESIPFed/science-on-schema.org","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"ESIPFed Science on Schema.org","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"lZxXursogY"}],"urlSource":"https://github.com/ESIPFed/science-on-schema.org","error":true,"key":"HEkjmtZLG3"},{"type":"text","value":" and Ocean Data net, DCAT, DCAT-AP, and ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"zRztWpGrK9"},{"type":"link","url":"https://docs.google.com/document/d/1OF49wTNVuv-6OXlNerhBTqVtHyc7jutTaUHjn6BZCs0","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"FDO Kernel Attributes-2.0","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"o1SAJx8wsS"}],"urlSource":"https://docs.google.com/document/d/1OF49wTNVuv-6OXlNerhBTqVtHyc7jutTaUHjn6BZCs0","key":"Gvrpp2rmK4"},{"type":"text","value":". These core content requirements are scoped for a broad spectrum of resource types; other fields will be added in the CDIF extension profiles.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"UDF796D9NH"}],"key":"YZP5ryf81v"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Information Model","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"jzvld75Z4e"}],"identifier":"information-model","label":"Information Model","html_id":"information-model","implicit":true,"key":"k2bWtLDgKK"},{"type":"heading","depth":3,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Required","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"j5nnlLk1rJ"}],"identifier":"required","label":"Required","html_id":"required","implicit":true,"key":"vTSnOqUqj1"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"If the content of a required element does not provide useful information, the metadata is considered useless for even the most rudimentary discovery use cases. Conformant metadata MUST provide valid values: an identifier for the described resource, a meaningful title that identifies the resource, either a URL or Distribution object (details later) that enables access to the resource, a statement of any licensing, usage, or access constraints (i.e., Rights),  an identifier for the type of resource described in the metadata, and identifier(s) for the specification of the metadata serialisation.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"FzYpqRA9VP"}],"key":"KlxCB8WiWH"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":20,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Resource identifier","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"t9V2U49ngI"}],"key":"fOsIJi4Bdb"},{"type":"text","value":" (1 entry): A globally unique, resolvable identifier for the resource described by the metadata record.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"uM9FTike1G"}],"key":"olt7UyNlui"}],"key":"owqdPhj8Fg"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Title","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"u1rc05stfL"}],"key":"CcdRKvNouI"},{"type":"text","value":" (1 entry): Succinct (preferably <250 characters) name of the resource; should be sufficient to uniquely identify the resource for a human user.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"CTyv6JUNys"}],"key":"f7iSqDacSS"}],"key":"SOqgGywLkw"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Distribution","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"jNudAU6OlX"}],"key":"ddTRKbIYLL"},{"type":"text","value":": URL, Distribution object, or Access Instructions (1 entry): There are several options. If the resource is a single digital object accessible online, provide a URL that will retrieve the resource. If the resource has multiple representations, or to provide users more information about the resource representation, a Distribution Object should be used to document the various possible representations and component files with a URL  for each. Metadata for distributions through an API that allows query, filter, or processing as part of a data access request are described in the Queryable Distribution Interfaces (API) section, below. If the resource is not accessible online, provide a URL to a landing page that describes how to access the resource.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"dM0TpU2XpK"}],"key":"enoObJVlkK"}],"key":"wzuUGE5U2u"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Rights","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Mv0qzg37EC"}],"key":"Def5mVSE7Y"},{"type":"text","value":" (1 to many entry): Information about required access permissions, licences, contractual requirements, use constraints, and security constraints. Might be described in text or through links to external documents.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"sXQo6KcPaS"}],"key":"HeODw8CWxk"}],"key":"In5S4vR1yH"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Resource type","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"hztpKTw5iz"}],"key":"W7IHtDmssg"},{"type":"text","value":" (1 to many): A scoped name (label with classification scheme) that specifies the kind of resource described by the metadata. The resource type might be used to determine validation requirements specific to descriptions for that kind of resource.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"EQlBpOTIpo"}],"key":"pbg3h1OriQ"}],"key":"yu3hPJKb6g"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Metadata profile identifier","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"RzGwnxuPYp"}],"key":"h3MI1p3Aeg"},{"type":"text","value":" (1 to many): Identifier for metadata specification (profile) used to create this metadata record. Generally this will be populated automatically if the metadata is created using CDIF aware tools.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"XnlZxmCpnY"}],"key":"AawxP9V2vj"}],"key":"nfYN5JFdhe"}],"key":"vuLL6J0BaR"},{"type":"heading","depth":3,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Recommended","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"F26r4Wws55"}],"identifier":"recommended","label":"Recommended","html_id":"recommended","implicit":true,"key":"Mae8fxDZfD"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Other properties that should be specified if possible and relevant. All are optional.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"OvxjRRS2bF"}],"key":"Jrain4rUn4"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Description","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"MtMBumSAGw"}],"key":"EmifvKF9az"},{"type":"text","value":" (0..1 entry): Inform users about the resource’s content, context, provenance, and any other information deemed useful for future cross-domain usage.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"FUbDEeE1FU"}],"key":"QtbZPksTwY"}],"key":"Rt2s9LHCZe"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Originators","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"sSzJz9t1qi"}],"key":"QZC7AVFfiq"},{"type":"text","value":" (0 to many entries): One or more parties (person or organisation) that have a role related to the origin of the resource, e.g., author or editor. Each party has a name (label), identifier, and optional contact information.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"RkNv1PCXhE"}],"key":"iL2EJhWJG4"}],"key":"nc5DOQZKyx"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Modified Date","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"fyx1YmECNT"}],"key":"A7tRb0y2aA"},{"type":"text","value":" (0..1 entry): Date (not temporal extent) when the most recent changes to the resource were completed. Use ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"xXJATqJ191"},{"type":"link","url":"https://en.wikipedia.org/wiki/ISO_8601","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"ISO 8601 date and time","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"NyPYNvuzDW"}],"urlSource":"https://en.wikipedia.org/wiki/ISO_8601","data":{"page":"ISO_8601","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"eZ12bKKttP"},{"type":"text","value":" format. Alternative date formatting must be machine-readable and consistent across all datasets.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"NFHaG73RcG"}],"key":"grhnjq0Riq"}],"key":"aOmevDpuWZ"},{"type":"listItem","spread":true,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Distribution Agent","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"BECD8Iv82W"}],"key":"sAldGlicoN"},{"type":"text","value":" (0..1 entry):The party (person or organisation) to contact about accessing the resource. Each party has a name (label), identifier, and optional contact information. If there are multiple distribution options with different contact points, the Distribution Agent should be specified as part of the Distribution Object.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"mYzDLzJD5D"}],"key":"c8tDXLJUam"}],"key":"DiCyycyut5"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Checksum","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"i7vG0fpIZG"}],"key":"pwI9WKzfPz"},{"type":"text","value":". (0 or 1): A string value calculated from the content of a digital object that allows verification that the content of the object has not been modified. Even insignificant changes to the content of the file will change its checksum. The algorithm used to calculate the checksum must be documented. See also ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"Eo8kusTiY2"},{"type":"link","url":"https://www.rfc-editor.org/rfc/rfc6920.html","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"RFC-6920 ‘Naming things with hashes’","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BR06vs5Nan"}],"urlSource":"https://www.rfc-editor.org/rfc/rfc6920.html","key":"W8z5YGy0ve"},{"type":"text","value":" that establishes ways to identify checksum algorithms and to represent checksum values as a URI. Note that checksums apply to specific digital objects, typically a unique resource representation. Non-digital resources do not have checksums; their representations can have checksums. See implementation notes in Appendix 1.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"iiuAmkBBrU"}],"key":"Teg7M4YvxA"}],"key":"fMbKItU7H2"},{"type":"listItem","spread":true,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Funding","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"CYQEXLUhy1"}],"key":"pgxhnWPcBF"},{"type":"text","value":". (0 to many entries): Cite funding sources (Grants, contracts...). Each source has a grant or contract identifier, source organisation, and label.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"Mi7x7e4SKu"}],"key":"U7K7I4Ffry"}],"key":"jNwAVkl8LE"},{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Keyword","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"fzqDoPiqG4"}],"key":"oxNXscoYCd"},{"type":"text","value":" (0 to many entries): Distinguish ‘tags’ and ‘controlled terms’. Tags are simply words that a metadata creator thinks will be useful for users to identify resources of interest. Controlled terms are words defined in a vocabulary that minimally include the word (a fixed string to identify the term for humans) and a definition. Each term represents some concept. More semantically rich vocabularies would include resolvable identifiers, source information, and links to related terms (see ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"aNv9hxAz18"},{"type":"cite","url":"https://doi.org/10.1371/journal.pcbi.1009041","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Cox et al., 2021","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"kTbqS5HRZn"}],"kind":"narrative","label":"Cox_2021","identifier":"https://doi.org/10.1371/journal.pcbi.1009041","enumerator":"1","key":"daS430gRGh"},{"type":"text","value":" ). One common set of relationships in a vocabulary is a kind-of hierarchy linking broader to narrower concepts. Controlled terms should minimally be represented with a label and scheme name that identifies the source vocabulary; ideally a term URI and scheme URI could be included for more accurate identification and data integration.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"yIMdHq75BG"}],"key":"SfE3Anseox"}],"key":"MlZFUWA7wq"},{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Policies","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"cT2i9Hu2Iz"}],"key":"VwvY7ib5XG"},{"type":"text","value":" (0 to many entries): Policies used in management of the described resource, including whether the content may be changed (mutable or immutable), any scheduled updates, what is the expected lifetime for resource availability, what (if any) is the maintenance schedule, versioning, documentation for changes and change requests. Explicit support for specific policy frameworks can be included (e.g., CARE).","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"P7CwbyoLmB"}],"key":"v5TyW14AEx"}],"key":"suEyORVxBb"},{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Publication Date","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"u5IINzi7Fn"}],"key":"EyiCxhShT9"},{"type":"text","value":" (0 or 1): Date (not temporal extent) when the resource was made accessible. Use a ‘year’ or ISO 8601 date and time format. Alternative date formatting must be machine-readable and consistent across all datasets. If no publication date is known, estimate the publication date range, enter the oldest year as the publication date, and include the estimated date range in the Description field.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"DCnjhSWaGl"}],"key":"BWC6rtVkPN"}],"key":"nEhqY1qmJK"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Other related agents","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"MRBtxjxbMd"}],"key":"ZwyPygtcBo"},{"type":"text","value":" (0 to many entries): Recognition for others who have contributed to the production of the resource but are not recognized as authors/creators. Includes a variety of roles like maintainer, publisher, point of contact, copyright holder, contributor (see e.g. ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"WXXnot9Ebl"},{"type":"link","url":"https://datacite-metadata-schema.readthedocs.io/en/4.5_draft/properties/recommended_optional/property_contributor.html#a-contributortype","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"DataCite contributor types","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"WQqFiLEh0t"}],"urlSource":"https://datacite-metadata-schema.readthedocs.io/en/4.5_draft/properties/recommended_optional/property_contributor.html#a-contributortype","key":"EDsqBdv7Af"},{"type":"text","value":", ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"xoMsPMAiFz"},{"type":"link","url":"https://wiki.esipfed.org/ISO_19115_and_19115-2_CodeList_Dictionaries#CI_RoleCode","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"ISO19115-1 role code","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"a9UZ5Ezo7s"}],"urlSource":"https://wiki.esipfed.org/ISO_19115_and_19115-2_CodeList_Dictionaries#CI_RoleCode","key":"DknRJL9SBA"},{"type":"text","value":" )","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"ZAQSch1uwm"}],"key":"p4NcXN0zPs"}],"key":"yGGLvS096w"},{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Related resources","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"AJSmxmQdDy"}],"key":"D7FXw0xMxl"},{"type":"text","value":" (0 to many entries): Links to related data, publications, annotation, data sources, software used, etc. Links have at least a label, relationship type, and resolvable target resource identifier.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"uvxJZkXGUb"}],"key":"SWKu8pL8bA"}],"key":"WEwFjThaaP"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Version","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"Ra7S18p2hO"}],"key":"thxITqlkPp"},{"type":"text","value":" (0 or 1): If the resource is versioned, specify the label for this version. Version labels should follow a scheme that allows alphanumeric sorting reflecting the order of version release.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"Jb3Zvac2cq"}],"key":"yYGcghyHSc"}],"key":"PxqVXzTW4y"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Provenance","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"scI0mlScWX"}],"key":"wlu5zBz1T6"},{"type":"text","value":" (0..many): For discovery, provide information about datasets that were used in the creation of the described resource and specify sensors, platforms, software, algorithms etc. used to aquire information contained in the resource.  Details about workflows, activity sequences, association of sensors etc. with specific variables, individuals associate with particular activities in workflow etc. require used of cdif prov extension (TBD).","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"m6WSoMBLXh"}],"key":"ESUPeo6ZUN"}],"key":"FE52qY1e1c"}],"key":"gjpuJJtp11"},{"type":"heading","d