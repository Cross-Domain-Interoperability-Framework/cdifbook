{"version":3,"kind":"Article","sha256":"b34de17d3d1d984d38103ea3c63142997946fcf3c6fa04c116588cdd6c9449c4","slug":"data-access.odrlincdif","location":"/data_access/odrlincdif.md","dependencies":[],"frontmatter":{"title":"ODRL Implementation","content_includes_title":false,"github":"https://github.com/Cross-Domain-Interoperability-Framework/cdifbook","numbering":{"title":{"offset":2}},"source_url":"https://github.com/Cross-Domain-Interoperability-Framework/cdifbook/blob/main/data_access/odrlincdif.md","edit_url":"https://github.com/Cross-Domain-Interoperability-Framework/cdifbook/edit/main/data_access/odrlincdif.md","exports":[{"format":"md","filename":"odrlincdif.md","url":"/cdifbook/preview-2026-05/build/odrlincdif-ec63264b99f93c6e069997c47e7a1f45.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Policy Example","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XKAh2xANEo"}],"identifier":"policy-example","label":"Policy Example","html_id":"policy-example","implicit":true,"key":"grYXwHN8JO"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Ahe data custodians can use ODRL to express a data asset access policy decomposed into specific access conditions, assets, actors, and actions.  This example is based on research environment in Australia.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"oiYMb7Dn2J"}],"key":"XDL9oCmxyl"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},