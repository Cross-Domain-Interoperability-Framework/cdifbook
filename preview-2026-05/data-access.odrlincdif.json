mple.com/dataset_6123\",\n\t\"action\": \"Analyse_In_TRE\",\n\t\"assignee\": {\n\t\t\"@type\": \"PartyCollection\",\n\t\t\"source\": \"ANU_Registered_Users\",\n\t\t\"refinement\": [\n\t\t\t{\n\t\t\t\"leftOperand\": \"Accredited_Researcher_Property\",\n\t\t\t\"operator\": \"eq\",\n\t\t\t\"rightOperand\": \"true\"\n\t\t\t}\n\t\t]\n\t  }\n\t},\n\t{\n\t\"target\": \"http://example.com/dataset_6123\",\n\t\"action\": \"SecondaryUse\",\n\t\"assignee\": {\n\t\t\"@type\": \"PartyCollection\",\n\t\t\"source\": \"ANU_Registered_Users\",\n\t\t\"refinement\": [\n\t\t\t{\n\t\t\t\"leftOperand\": \"Researcher_Location_Property\",\n\t\t\t\"operator\": \"eq\",\n\t\t\t\"rightOperand\": \"Australia\"\n\t\t\t}\n\t\t\t]\n\t\t}\n\t}\n\t]\n}","position":{"start":{"line":12,"column":1},"end":{"line":50,"column":1}},"key":"dK3NuD2k8T"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Example ODRL Policy.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Vq7YWthagq"}],"key":"gnQcnAeywu"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Note that in this example Actions, PartyCollections and Refinements only have local meaning and can only be executed locally. ‘Analyse_In_TRE’ and ‘SecondaryUse’ are labels that have no potential for machine-actionability beyond the local repository environment.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"GUVBhBHKEL"}],"key":"Lc4olw7ivA"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Policy Template","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"znMN6PuJp5"}],"identifier":"policy-template","label":"Policy Template","html_id":"policy-template","implicit":true,"key":"r5he1nrluk"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Conventions for ODRL policies to express access conditions could support more granular groupings of datasets based on their common access features. Re-usable ODRL policies could be deployed across multiple repositories enabling a metadata harvesters to aggregate content about access and make access conditions transparent for users searching the catalogue.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"GlGQkgL9tc"}],"key":"zq9gQWOTt6"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"This approach uses a vocabulary of common, reusable Actions defined in the ","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"wVH6JfeCwS"},{"type":"link","url":"https://www.w3.org/TR/odrl-vocab/#actionsCommon","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"ODRL Core Vocabulary","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"kK3Qzo3h6V"}],"urlSource":"https://www.w3.org/TR/odrl-vocab/#actionsCommon","key":"iwvXFY4f8i"},{"type":"text","value":" to populate the ‘action’ element. Additional terms can be defined in ‘ODRL Profiles’ (outside of the scope of this document), an extension mechanism for the core model and vocabulary.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"DI58BJBvD2"}],"key":"Z6PZiBs3Qr"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"The ODRL syntax is used to assert a generic Party in the ‘source’ element, and then refines it to a particular subset of parties with attributes in the ‘refinement’ section.  In practice, there is a finite number of ‘refinement’ permutations that could be pre-defined and assigned a persistent URI to be used as the ‘source’ key above alongside the dereferenced {leftOperand, operator, rightOperand} array.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"tcKYoLFndm"}],"key":"EMC8LYsJAo"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Access policies typically define types of users (parties) and what actions they can, cannot or must perform. This depends on referencing a number of standard ODRL ‘Parties’ or ‘Actions’ by URI.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"S9s7h5TCwc"}],"key":"lwmL9btTOS"},{"type":"code","lang":"","value":"\"permission\": [\n{\n\"target\": \"http://example.com/example_digital_object\",\n\"action\": _Actions_,\n\"assignee\": {\n\t\"@type\": \"PartyCollection\",\n\t\"source\": _genericParty_,\n\t\"refinement\": [\n\t\t{\n\t\t\t\"leftOperand\": _constraintProperty_,\n\t\t\t\"operator\": _constraintPredicate_,\n\t\t\t\"rightOperand\": _constraint_value_\n\t\t}\n\t]\n\t}\n}\n]","position":{"start":{"line":65,"column":1},"end":{"line":83,"column":1}},"key":"Dn9qv08UPe"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Example. ODRL Policy template for re-usable ‘Parties’ and ‘Actions’","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"LS84pyLOnq"}],"key":"VpBsHpObZx"},{"type":"code","lang":"","value":"\"permission\": [\n{\n\"target\": \"http://example.com/example_digital_object\",\n\"action\": \"http://cdif.org/odrl/1/download\",\n\"assignee\": {\n\t\"@type\": \"PartyCollection\",\n\t\"source\": \"https://cessda.eu/partycollection:312\",\n\t\"refinement\": [\n\t\t{\n\t\t\t\"leftOperand\": \"http://www.w3.org/ns/odrl/2/spatial\",\n\t\t\t\"operator\": \"http://www.w3.org/ns/odrl/2/eq\",\n\t\t\t\"rightOperand\": \"de\"\n\t\t}\n\t]\n\t}\n}\n]","position":{"start":{"line":87,"column":1},"end":{"line":105,"column":1}},"key":"VKKnT0RyRb"},{"type":"div","identifier":"exampleconcretepolicy","label":"exampleconcretepolicy","children":[{"type":"text","value":"Example ODRL Policy statement","key":"C6MSyO3wO2"},{"type":"div","children":[{"type":"text","value":". This policy asserts that users located in Germany have the ‘Download’ permission. The reusable 'PartyCollection' item https://cessda.eu/partycollection:312 (signifying users located in Germany) is re-used from an existing vocabulary used by multiple repositories.","key":"nZuJ76Ra9X"}],"key":"FYsx3d3SFM"}],"html_id":"exampleconcretepolicy","key":"duoZzSHXun"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"The example here disambiguates prose representation of access policies by using URIs as references to (i) pre-defined process actors (ORDL ‘Parties’) and (ii) pre-defined procedural steps (ODRL ‘Actions’), framed in consistent syntactical way. These examples do not in themselves provide sufficient detail or semantics for automated implementation of complex rule-based workflows across multiple parties. To enable repeatable and consistent implementation of request fulfillments framed by ODRL policies, conventions to invoke machine-actionable workflows are needed, for example using ","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"yC6Oja2wPh"},{"type":"link","url":"https://www.commonwl.org/","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Common Workflow Language (CWL)","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"WvmCEdottn"}],"urlSource":"https://www.commonwl.org/","key":"lGHCM6Mt0v"},{"type":"text","value":", including downstream invocations such as creating on-demand secure analytics environments (Infrastructure-as-code or IaaC).","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"WcLCKDMaDf"}],"key":"Kpv05zjQkY"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"A common language for expressing data access policies across the cooperative of data providers using the clearing house is a necessary but insufficient first step. A shared understanding of how policies interface with business processes is also required so that both data provider and the clearing house can be satisfied that request fulfilment was efficient, consistent and auditable.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"zQICR9KYhv"}],"key":"pHUyvPYOh9"},{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Taking CDIF to the next level of maturity in the access arena will mean committing to the creation of a CDIF ODRL Profile that extends the core ODRL ontology and vocabulary so that a widely applicable set of cross-domain Actions are available for re-use as well as being associated with unambiguous workflow implementations, expressed with additional classes and attributes in the CDIF ODRL Profile.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"cqHZVHLfKu"}],"key":"xouBmbT928"},{"type":"heading","depth":2,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"Connecting CDIF and ODRL","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"Nya1ixBLei"}],"identifier":"connecting-cdif-and-odrl","label":"Connecting CDIF and ODRL","html_id":"connecting-cdif-and-odrl","implicit":true,"key":"aSM7vCO7uC"},{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"(under construction)\nCDIF recommends that a DCAT record be created, describing a dcat:distribution or, in lay parlance, a digital object, corresponding to the data set or resources to be used. For queryable data sources, this would instead be a dcat:service. (The dcat:dataset class is not used, because different distributions of it may have different access conditions.) An ODRL Rule has a mandatory ‘target’ attribute which specifies the ODRL Asset to which the Rule applies. For example:","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"wHFtF6Ljis"}],"key":"sWmS2QTR4s"},{"type":"code","lang":"","value":"\"permission\": [\n\t{\n\t\t\"target\": \"http://repository7987.org/dataset_6123\",\n\t\t\"action\": \"http://cdif.org/odrl/1/download\",\n\t\t\"assignee\": \"http://orciduser675765\",\n\t}","position":{"start":{"line":120,"column":1},"end":{"line":127,"column":1}},"key":"Zx8FbQaxzQ"},{"type":"paragraph","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"Conversely, a DCAT record could express a predicate ","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"NC9lJIsM8y"},{"type":"link","url":"http://www.w3.org/ns/odrl/2/hasPolicy","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"http://​www​.w3​.org​/ns​/odrl​/2​/hasPolicy","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"g40XuiJxCD"}],"urlSource":"http://www.w3.org/ns/odrl/2/hasPolicy","key":"TsFN4wAGUx"},{"type":"text","value":" with the URI of the ODRL Policy as a target.","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"xbFcmU6QiD"}],"key":"r78dWbBKN2"},{"type":"paragraph","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"An ODRL policy might apply to multiple ODRL Assets. One possible solution is to leverage the ODRL AssetCollection class, which can group multiple Assets under one URI as the target of an ODRL rule. This requires policies defining persistent grouping rules that define an AssetCollection, determining if and how the membership of the AssetCollection can change.","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"vLk3izX91j"}],"key":"x4rOg13Of0"}],"key":"wBSvi9aEqL"}],"key":"mYoRplvnXV"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Federated Analytics","url":"/data-access/odrlfederatedanalysis","group":"Profiles/Recommendations"},"next":{"title":"Universals: Time, Geography, and Units of Measurement","url":"/universals/univintro","group":"Profiles/Recommendations"}}},"domain":"http://localhost:3000"}