on the software used, but typically include a metadata record identifier and a format parameter that would be used to indicate that CDIF metadata should be returned. If there is a format parameter in URL requests, its value should be ‘","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"pDYqrGDWxD"},{"type":"strong","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"CDIF1.0","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"nOlqdLqiEY"}],"key":"Bfu2F2YNa9"},{"type":"text","value":"’.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"XofP7YM1BQ"}],"key":"CFOHAVkvxx"}],"key":"UgH0f9Myjq"}],"key":"bQrmlZ8IwZ"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Option 3. Metadata list file","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"WBNfq3yUUS"}],"identifier":"option-3-metadata-list-file","label":"Option 3. Metadata list file","html_id":"option-3-metadata-list-file","implicit":true,"key":"uLOIc8HD8L"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":22,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A collection of metadata records is gathered in one file accessed using a single URL. For CDIF, this file should contain a set of CDIF JSON-LD metadata objects, implemented as a ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"M9fodh7sRz"},{"type":"link","url":"http://schema.org","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"schema.org","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"GcRfsIXv4U"}],"urlSource":"http://schema.org","key":"dopULXKZtM"},{"type":"text","value":" ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"cx2AzUQhsX"},{"type":"link","url":"https://schema.org/ItemList","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"ItemList","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Gs1e6Hx2MP"}],"urlSource":"https://schema.org/ItemList","key":"A2Zf1YoPWG"},{"type":"text","value":". See example in Appendix 1. The MIME type for the collection is:","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"w4HawAxBBh"}],"key":"AxSFxNUuC8"}],"key":"RMyrMiAcff"}],"key":"jZZleSmAbT"},{"type":"paragraph","children":[{"type":"text","value":"*type=\"application/ld+json\" profile=\"CDIF-list-1.0\"*","key":"jFxoqUg9Cs"}],"key":"fkNK89KU3v"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Find metadata","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"zGFzqMcmez"}],"identifier":"find-metadata","label":"Find metadata","html_id":"find-metadata","implicit":true,"key":"WwMltIxEHv"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"CDIF recommends the use of sitemaps to address the questions of how crawlers find metadata to index or use. A ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"aGkC7NeuSE"},{"type":"link","url":"https://www.sitemaps.org/protocol.html","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"sitemap","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"E8IOtL1Y4I"}],"urlSource":"https://www.sitemaps.org/protocol.html","key":"MO6xc3vdpn"},{"type":"text","value":" is an XML document that a metadata crawler or harvester can access (","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"VL9Ei9ChAg"},{"type":"strong","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"6","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ZiHUucFK8M"}],"key":"Td7qgBovSr"},{"type":"text","value":" in the figure above). The basic sitemap is an XML document that is a structured list of URLs, with an optional date stamp property that should indicate when the metadata at the URL target location was last updated. The most basic CDIF recommended approach for resources that have landing pages that can be modified is Option 1 outlined above. The workflow for a harvester in this approach corresponds to existing structured data on the Web practice, with metadata conforming to the CDIF recommendations. Existing robots.txt and sitemap files can be used, and no modifications need to be made to HTTP headers provided by resource servers.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"OTVwAEbgOY"}],"key":"XripD19GDC"},{"type":"image","url":"/cdifbook/preview-2026-05/build/basicharvestingpatte-0db93bb26e25a609f3e4473d4274aff5.jpg","alt":"Basic harvesting pattern","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"zCkh3azIY4","urlSource":"./figures/basicharvestingpattern.jpg"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Figure. Basic harvesting pattern: sitemap with locations that contain HTML documents with embedded CDIF metadata","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"STbxa8ye3C"}],"key":"HP0t8cHJtP"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"If resources do not have landing pages, or the landing pages cannot be modified, harvesters must be provided with links to the metadata records to index. The basic approach for this next level of service is similar, but the harvester cannot assume that the metadata is embedded in the content accessed from the sitemap url/loc. The sitemap url/locs must either get the metadata document directly, or it might get the resource content directly. In the second case, a URL to get the metadata must be included in the HTTP response header. Because the basic sitemap only provides a URL, the harvester will need to check which of these options is being used. The approach using standard Web architecture is to inspect the HTTP response header. If the returned document is a CDIF metadata document, the header will have a content-type parameter with the value “","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ypyxjpVzB5"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"application/ld+json; profile=‘CDIF1.0’","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"gBRCa9LrCi"}],"key":"JKeGGiSqCf"},{"type":"text","value":"” or ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"LSvc7B1aWL"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"profile=‘CDIF-list-1.0’","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ty9rQvkUTb"}],"key":"gU0qUb3L1f"},{"type":"text","value":" if the document is an itemList with multiple metadata records. The harvester should get the content at the sitemap url/loc and use that. If the content-type has a different value, then the header should have link element with ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"hkDgH0idGj"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"rel=‘describedby’","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"aPmC7JlZ1g"}],"key":"aynYsjdUFS"},{"type":"text","value":", ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BV4tBRJUOw"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"type=‘application/ld+json’","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"XHBqJdAUgX"}],"key":"g2OFHJV4mQ"},{"type":"text","value":", and ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"YYs29uLyMX"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"profile=‘CDIF1.0’","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"HzxyIFFNX3"}],"key":"FsEyKmcGk0"},{"type":"text","value":" or ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"kNOmNSw31k"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"profile=‘CDIF-list-1.0’","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"EGFKxRlQok"}],"key":"ImJ4SaEr3U"},{"type":"text","value":". In this case, the harvester will GET the content at the link href and use that. Inclusion of the describedby link in the HTTP header is the pattern used by Signposting.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"HhxNZuk4b1"}],"key":"f86zHYNRux"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Other ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"OCPoDQxPXZ"},{"type":"link","url":"/metadata/signpostinglinkrel","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Signposting links","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"xc6qzJMyjR"}],"urlSource":"./signpostinglinkrel.md","dataUrl":"/metadata.signpostinglinkrel.json","internal":true,"protocol":"file","key":"SX3JlrTVTn"},{"type":"text","value":" could be inserted into the HTTP response headers (or HTTP landing pages if they exist) if Web site administrators allow. This can provide additional value for clients implementing signposting.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"CfQmXH9lIh"}],"key":"Xym0p7xAcX"},{"type":"image","url":"/cdifbook/preview-2026-05/build/harvestnoembeddedscr-470e8ddd62583ed17830e95d1a9b6e6a.jpg","alt":"Harvesting pattern for locations that do not have embedded metadata scripts","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"JiGEMtUen7","urlSource":"./figures/harvestnoembeddedscript.jpg"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Figure. Harvesting pattern for locations that do not have embedded metadata scripts. Either the url/loc content is a metadata document (JSON-LD, CDIF profile), or there is a Signposting link with ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"RcUvxeV4Z5"},{"type":"emphasis","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"rel=describedby","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"SrzyQPwAum"}],"key":"dnET2ymdWT"},{"type":"text","value":" in the HTTP head. To indicate that this is not a standard sitemap, the robots.txt link to the sitemap should identify CDIF1.0 as the userAgent.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"qR5JTqIF55"}],"key":"u85WdNi2GC"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Note that in this second case, the sitemap url/loc locations will get content that is not HTML. A non-CDIF aware harvester will be expecting HTML (or indexable text) content, and this might cause problems. Harvesters will generally find the sitemap using a link from a ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"GLUjbwBkJQ"},{"type":"link","url":"https://datatracker.ietf.org/doc/rfc9309/","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"robots.txt","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"dxFl9mrzIZ"}],"urlSource":"https://datatracker.ietf.org/doc/rfc9309/","key":"k1CTJPk1Iq"},{"type":"text","value":" file placed in the root of the server containing the sitemap and metadata. In the robots file, the user agent value can be used to indicate a sitemap link for CDIF-aware agents in cases for which the sitemap links are not to pages that have embedded CDIF metadata <script> elements. If the harvester accesses a sitemap under this user agent, the url/loc location content should be processed as outlined in the last paragraph.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"sjI3L3j3dB"}],"key":"AMyNkTg41F"},{"type":"paragraph","children":[{"type":"text","value":"User-agent: CDIF1.0","key":"QdaJhEfcV6"}],"key":"KC3Q0tj2gZ"},{"type":"paragraph","children":[{"type":"text","value":"Sitemap: http://www.example.com/CDIFsitemap.xml","key":"d1qZTCMwdK"}],"key":"w81PZILdDY"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Based on these recommendations, metadata generated using the CDIF content and serialisation can be found and harvested by agents using standard off-the-shelf Web technology.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"Zabn69mwqC"}],"key":"Vu7GOwJ315"}],"key":"ZtQs0EfJyl"}],"key":"FQcocTju7T"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Basic discovery metadata content model","url":"/metadata/contentmodel","group":"Metadata technical expression"},"next":{"title":"Core","url":"/metadata/core","group":"Profiles/Recommendations"}}},"domain":"http://localhost:3000"}