{"version":3,"kind":"Article","sha256":"255531aaca08687d132807674c9a053a66a186b323e636ed93af852137911343","slug":"metadata.profilesoverview","location":"/metadata/profilesoverview.md","dependencies":[],"frontmatter":{"title":"Overview of CDIF Profiles","content_includes_title":false,"authors":[{"nameParsed":{"literal":"World Fair CDIF working group","given":"World Fair CDIF","non_dropping_particle":"working","family":"group"},"name":"World Fair CDIF working group","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/Cross-Domain-Interoperability-Framework/cdifbook","numbering":{"title":{"offset":1}},"source_url":"https://github.com/Cross-Domain-Interoperability-Framework/cdifbook/blob/main/metadata/profilesoverview.md","edit_url":"https://github.com/Cross-Domain-Interoperability-Framework/cdifbook/edit/main/metadata/profilesoverview.md","exports":[{"format":"md","filename":"profilesoverview.md","url":"/cdifbook/preview-2026-05/build/profilesoverview-3d5e793b66ad9c1390328902ab8b72b2.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Profile Content","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Eg6v95zXvX"}],"identifier":"profile-content","label":"Profile Content","html_id":"profile-content","implicit":true,"key":"PKYJDDGxfD"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"A CDIF profile is a set of recommended common metadata to be provided in support of a function which implements the FAIR principles, sufficient for use across domain and infrastructure boundaries. The profiles do not describe comprehensive sets of metadata – every FAIR resource and domain is different, and may require specialized metadata description.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"XWLC2tSzhM"}],"key":"fnZUnup2G9"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Each CDIF profile has a stated purpose and set of requirements. Based on this purpose and the requirements, the profile is represents is an implementation-independent conceptual model. To make the profile useable, CDIF recommends a specific implementation. In some cases there might be more than one such implementation, based on the existing culture of practice. Regardless, the conceptual model is consistent across all implementations. This conceptual model is documented here for each profile in text, listing the required information items, in some cases supplemented by a formal UML model.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"zNr0hq52nR"}],"key":"MTxyFq1SRe"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"For technical use, a set of artefacts is made available for each profile implementation, published in a GitHub repository. These artefacts include:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"LxxseNYkGv"}],"key":"WKqwuvLEiy"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"A specification of all implemented classes, properties, and datatypes in a text document labeled “Implementation Guide.” This serves as the core documentation of what each implemented profile contains.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Yy0cyT35AW"}],"key":"IdxASHcAzq"}],"key":"jb8hhdvMED"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"A JSON Schema for validating JSON instance documents, and for helping developers understand what is included in the profile and requires or is available for support in applications. Because the implementation uses JSON-LD, these JSON schema require instance documents to be in compacted form (see ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"tiZInVzSRy"},{"type":"link","url":"https://github.com/Cross-Domain-Interoperability-Framework/validation/blob/main/docs/CDIF-profiles-metadata-validation.md","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"CDIF profiles metadata validation","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"y7UCDrBvuI"}],"urlSource":"https://github.com/Cross-Domain-Interoperability-Framework/validation/blob/main/docs/CDIF-profiles-metadata-validation.md","data":{"kind":"file","org":"Cross-Domain-Interoperability-Framework","repo":"validation","reference":"main","file":"docs/CDIF-profiles-metadata-validation.md","raw":"https://raw.githubusercontent.com/Cross-Domain-Interoperability-Framework/validation/main/docs/CDIF-profiles-metadata-validation.md"},"internal":false,"protocol":"github","key":"ycc0NKR8IM"},{"type":"text","value":")","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"PPlocW8ONR"}],"key":"tSCTpnaWFP"}],"key":"tZGKxfOHcH"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"A set of SHACL rules for RDF validation of JSON-LD instances, and to help Linked Data developers understand what is available within a CDIF graph. The SHACL rules can be used to validate metadata instances in any JSON-LD serialization (compacted, flattened, expanded)","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"uwjOAlmFoq"}],"key":"Rah6Vw7ppu"}],"key":"qVoQjpxX6x"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"A set of example instances, showing how the conforming metadata should appear in JSON-LD.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"o1Q2oPDI8N"}],"key":"ZijJnAh5em"}],"key":"ZETDWv3VyM"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"A JSON Framing document. This is a special JSON-LD document that maps JSON-LD keys to a particular compacted JSON structure, in this case the structure expected by the CDIF JSON schema. This framed format is a typical JSON hierarchical tree structure with nested inline properties, typically much easier for humans to understand. Framing allows any instance document to be validated with the JSON schema. Each profile repository also includes a python program (FrameAndValidate.py) that takes a JSON-LD document as input, applies the framing document and validates with the JSON schema in that repository. This is documented in the repository readme.md file.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"lCWDwnVvzH"}],"key":"ubz4j7JBf3"}],"key":"N1fXevSZW7"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"For those profiles which have been implemented as a UML model, hyper-linked field-level documentation will be made available as an html document, connecting specific classes to their expression in implementation artefacts such as SHACL and JSON Schema, as well as in a version of the model expressed in the XMI interchange format.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"a8Cwg5pJ4f"}],"key":"MLrPCmSLIQ"}],"key":"RHFar00DHG"}],"key":"YjVuymVHzx"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Overview of Profiles in Version 1.1","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"olP0lySeiK"}],"identifier":"overview-of-profiles-in-version-1-1","label":"Overview of Profiles in Version 1.1","html_id":"overview-of-profiles-in-version-1-1","implicit":true,"key":"W640RKpwqE"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"This section provides a brief overview of the currently targeted profiles. More details are presented in subsequent sections.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ktFXsv18ia"}],"key":"YsV2giBaWU"},{"type":"heading","depth":3,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Core","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"K5HnOSSY3j"}],"identifier":"core","label":"Core","html_id":"core","implicit":true,"key":"CZLZnKmvqq"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"The CDIF Core profile defines the mandatory and optional base properties for any CDIF metadata record, implemented as JSON-LD using the ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"IB6UVd55mB"},{"type":"link","url":"http://schema.org","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"schema.org","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"sdFCDyrkdK"}],"urlSource":"http://schema.org","key":"CdaFWrbAfj"},{"type":"text","value":" vocabulary.  The Core profile release repository is here: ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"cWNhzvxynq"},{"type":"link","url":"https://github.com/Cross-Domain-Interoperability-Framework/profile-core/blob/reviewRevision202606/README.md","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/Cross​-Domain​-Interoperability​-Framework​/profile​-core","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"aV3D3axODU"}],"urlSource":"https://github.com/Cross-Domain-Interoperability-Framework/profile-core/blob/reviewRevision202606/README.md","data":{"kind":"file","org":"Cross-Domain-Interoperability-Framework","repo":"profile-core","reference":"reviewRevision202606","file":"README.md","raw":"https://raw.githubusercontent.com/Cross-Domain-Interoperability-Framework/profile-core/reviewRevision202606/README.md"},"internal":false,"protocol":"github","key":"nNCyHBcQ6P"}],"key":"l3WlbppmRR"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Data Discovery","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"V1EJhJGGMp"}],"identifier":"data-discovery","label":"Data Discovery","html_id":"data-discovery","implicit":true,"key":"H7wc1Zb690"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"The Discovery profile defines optional properties for documenting spatial or temporal extent, and simple documentation of variables specified in a resource. This recognizes that there are a variety of resources of interest that might not have relevant spatial or temporal extent, and might not explicitly define variables with values. The Discovery release repository is here: ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"pAJT34yg1Z"},{"type":"link","url":"https://github.com/Cross-Domain-Interoperability-Framework/profile-discovery/blob/reviewRevision202606/README.md","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/Cross​-Domain​-Interoperability​-Framework​/profile​-discovery","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"JXyT1PA4ex"}],"urlSource":"https://github.com/Cross-Domain-Interoperability-Framework/profile-discovery/blob/reviewRevision202606/README.md","data":{"kind":"file","org":"Cross-Domain-Interoperability-Framework","repo":"profile-discovery","reference":"reviewRevision202606","file":"README.md","raw":"https://raw.githubusercontent.com/Cross-Domain-Interoperability-Framework/profile-discovery/reviewRevision202606/README.md"},"internal":false,"protocol":"github","key":"tzDUN1d9KR"}],"key":"WTKuK98Fgd"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Data Description","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"Ar06QTIGrR"}],"identifier":"data-description","label":"Data Description","html_id":"data-description","implicit":true,"key":"N9g4O0xKut"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"The CDIF Data Description profile defines metadata elements for documentation of variable value domains, statistics aggregating variable values, physical data file layout, and roles of variables in a dataset (e.g. identifier, measure, attribute).  The Data Description release repository is here: ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"aWR8q4lDwJ"},{"type":"link","url":"https://github.com/Cross-Domain-Interoperability-Framework/profile-datadescription/blob/reviewRevision202606/README.md","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/Cross​-Domain​-Interoperability​-Framework​/profile​-datadescription","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"b8VOdcFLrz"}],"urlSource":"https://github.com/Cross-Domain-Interoperability-Framework/profile-datadescription/blob/reviewRevision202606/README.md","data":{"kind":"file","org":"Cross-Domain-Interoperability-Framework","repo":"profile-datadescription","reference":"reviewRevision202606","file":"README.md","raw":"https://raw.githubusercontent.com/Cross-Domain-Interoperability-Framework/profile-datadescription/reviewRevision202606/README.md"},"internal":false,"protocol":"github","key":"cPjCCZcREw"}],"key":"uPpiJTC6x0"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Codelist","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"zbeT4wnovJ"}],"identifier":"codelist","label":"Codelist","html_id":"codelist","implicit":true,"key":"PQOOFBfJiu"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"The CDIF Codelist profile defines how controlled vocabularies and classification schemes are represented as SKOS ConceptSchemes in JSON-LD. The profile composes skos:ConceptScheme and skos:Concept with CDIF-specific requirements inherited from cdifCore.  Concept properties include a preferred label, bidirectional hierarchy, notation.  CDIF core metadata properties are included on the ConceptScheme. The key feature of the codelist is specification of the ‘notation’ for a concept -- the strings that actually appear in data, along with a human-readable lable conveying the meaning of the code.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"GE9uXh3PAJ"}],"key":"vNxmvhUk5e"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The implementation uses the SKOS (Simple Knowledge Organization System) vocabulary with JSON-LD serialization. This profile aligns with the approach described in ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"sg1mTrw3Of"},{"type":"link","url":"https://cros.ec.europa.eu/book-page/modeling-eurostats-statistical-classifications-showvoc","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"‘Modelling of Eurostat’s Statistical Classifications in ShowVoc’","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"nfYHwEjOpd"}],"urlSource":"https://cros.ec.europa.eu/book-page/modeling-eurostats-statistical-classifications-showvoc","key":"h4je4O8fuM"},{"type":"text","value":", but in alignment with cdifCore, the required properties from cdifCore are implemented using ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"wjAV5tXYGf"},{"type":"link","url":"http://schema.org","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"schema.org","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"GZ0MvmIwa3"}],"urlSource":"http://schema.org","key":"WReTyoLBBD"},{"type":"text","value":" elements. The Codelist release repository is here: ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"xbiPj6MdXM"},{"type":"link","url":"https://github.com/Cross-Domain-Interoperability-Framework/profile-codelist/blob/reviewRevision202606/README.md","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/Cross​-Domain​-Interoperability​-Framework​/profile​-codelist","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"OVLoew1R1N"}],"urlSource":"https://github.com/Cross-Domain-Interoperability-Framework/profile-codelist/blob/reviewRevision202606/README.md","data":{"kind":"file","org":"Cross-Domain-Interoperability-Framework","repo":"profile-codelist","reference":"reviewRevision202606","file":"README.md","raw":"https://raw.githubusercontent.com/Cross-Domain-Interoperability-Framework/profile-codelist/reviewRevision202606/README.md"},"internal":false,"protocol":"github","key":"RdyhSuQntL"}],"key":"zUbQsI36wt"},{"type":"heading","depth":3,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Data Structure","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"d2Pcc3vE1N"}],"identifier":"data-structure","label":"Data Structure","html_id":"data-structure","implicit":true,"key":"dUgccyrEJJ"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"This profile supports the description of reusable data structures and/or their component variables. Enumerated values for variables are described using the Codelist profile. This profile primarily uses the DDI-CDI standard.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"IKde4vuDYL"}],"key":"FvsHhKdkoe"},{"type":"heading","depth":3,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Concept Scheme","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"uAqol51TSB"}],"identifier":"concept-scheme","label":"Concept Scheme","html_id":"concept-scheme","implicit":true,"key":"DaNaFNpZZw"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"This profile uses SKOS to describe concept systems which are meaningful for purposes other than the representation of variable values. Domain ontologies may need to be expressed for FAIR use: this profile is intended as a supplement to ontologies described in OWL as it can be rendered using tools such as SKOSify from them, so that they are more widely accessible.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"eng2CdLQ2e"}],"key":"cDd10HnvJ1"},{"type":"heading","depth":3,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Manifest","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"XOKYFJrfB9"}],"identifier":"manifest","label":"Manifest","html_id":"manifest","implicit":true,"key":"XTD3yf5yK4"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"This profile is used to package metadata and FAIR resources, to form bundles for dissemination, archiving, etc. It can be used to render “webby” FDOs. The recommended implementation uses ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"pkKXPbyqKE"},{"type":"link","url":"https://www.researchobject.org/ro-crate/","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"RO Crate","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"PCN7I7REvK"}],"urlSource":"https://www.researchobject.org/ro-crate/","key":"TAflDbqk6d"},{"type":"text","value":".","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"fvytBkGYvJ"}],"key":"XxrNqhkOls"},{"type":"heading","depth":3,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Access","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"qJpELHYjrh"}],"identifier":"access","label":"Access","html_id":"access","implicit":true,"key":"bxQbSC6q5z"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"This is a general guideline for the use of the ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"SnFvOfCjma"},{"type":"link","url":"https://www.w3.org/TR/odrl-model/","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Open Digital Rights Language (ODRL)","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"ihBlhmOco0"}],"urlSource":"https://www.w3.org/TR/odrl-model/","key":"jrVTq1nNXw"},{"type":"text","value":" to describe the policies for the access conditions and use of FAIR resources.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"w0fnwDaB5G"}],"key":"pQbd3CRMng"},{"type":"heading","depth":3,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Universals","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"vKYaosDui1"}],"identifier":"universals","label":"Universals","html_id":"universals","implicit":true,"key":"Ug55EuGSe4"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Time, geography, and units of measure are used ubiquitously in data and metadata, and are important for the integration and use of data. This profile gives some general guidance on these important topics.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"s3lODc0QOl"}],"key":"utcIjSn4Sb"}],"key":"LiZy3HMbpB"}],"key":"w66M6CaCQ1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{