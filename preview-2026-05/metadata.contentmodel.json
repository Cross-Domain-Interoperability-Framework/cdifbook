":1},"end":{"line":47,"column":1}},"key":"EjNlnNhf2F"}],"key":"xnneqdRjDF"}],"key":"oun936O2lP"}],"key":"lLiWjWZZy3"}],"key":"D3e1wRXXeQ"}],"key":"BSRvOZYO2l"},"references":{"cite":{"order":["Cox_2021"],"data":{"Cox_2021":{"label":"Cox_2021","enumerator":"1","doi":"10.1371/journal.pcbi.1009041","html":"Cox, S. J. D., Gonzalez-Beltran, A. N., Magagna, B., & Marinescu, M.-C. (2021). Ten simple rules for making a vocabulary FAIR. <i>PLOS Computational Biology</i>, <i>17</i>(6), e1009041. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1371/journal.pcbi.1009041\">10.1371/journal.pcbi.1009041</a>","url":"https://doi.org/10.1371/journal.pcbi.1009041"}}}},"footer":{"navigation":{"prev":{"title":"Publishing metadata","url":"/metadata/publishingmetadata","group":"Metadata technical expression"},"next":{"title":"Metadata publication","url":"/metadata/publication","group":"Metadata technical expression"}}},"domain":"http://localhost:3000"}