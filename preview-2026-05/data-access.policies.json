start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A central clearing house mediating access to data in federated repositories ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"odbcq9X9fT"},{"type":"link","url":"/data-access/odrlsharedservices","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Mediated access","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"q1E25UvkIT"}],"urlSource":"./odrlsharedservices.md","dataUrl":"/data-access.odrlsharedservices.json","internal":true,"protocol":"file","key":"nfZsKLfLjS"}],"key":"tHNwf2sa2n"}],"key":"kYg4dbNh2K"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Federated analysis over multiple sensitive data providers ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"xMbPQHcJbl"},{"type":"link","url":"/data-access/odrlfederatedanalysis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Federated analytics","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"prvvFWkGC5"}],"urlSource":"odrlfederatedanalysis.md","dataUrl":"/data-access.odrlfederatedanalysis.json","internal":true,"protocol":"file","key":"qD9XIf1aR6"}],"key":"bViNniH5oE"}],"key":"e1Rfa9Iqsx"}],"key":"CkWDvPQhI8"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"These scenarios build a set of typical requirements for the interoperability of access policy summarised in the figure below.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"zcsIP1sre0"}],"key":"gf1pt7kpvt"},{"type":"image","url":"/cdifbook/preview-2026-05/build/d