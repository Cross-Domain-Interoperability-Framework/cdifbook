n":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JHG7LnRWkQ"}],"urlSource":"https://mapping-commons.github.io/sssom/dev/","key":"GaSVwPoYJj"},{"type":"text","value":") is seen as a useful standard for the expression of mappings, with the RDF Mapping Language ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Uzn5bi5Xvj"},{"type":"link","url":"https://rml.io/specs/rml/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"RML","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oMAU4vqLMb"}],"urlSource":"https://rml.io/specs/rml/","key":"Tg2LZmh9VX"},{"type":"text","value":" also proving to be of interest, This is an area where more work remains to be done, but will be the subject of a CDIF profile in the not-too-distant future.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tMAuhxFGy9"}],"key":"HGeqOED5Ci"}],"key":"eGYg3jolNM"}],"key":"zeXM1H8Enq"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Standards for Data Description","url":"/data-description/dataintegrationstandards","group":"Open Topics, Future Profiles"},"next":{"title":"Provenance","url":"/future/provenance","group":"Open Topics, Future Profiles"}}},"domain":"http://localhost:3000"}